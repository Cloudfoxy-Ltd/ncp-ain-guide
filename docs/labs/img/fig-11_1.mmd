flowchart LR
    subgraph BUILD["Build (oob-mgmt-server)"]
        direction TB
        V["vars/*.yaml"]:::oob --> T["templates/underlay.j2"]:::ctl
        T --> R["render.py → rendered/*.nvue"]:::ctl
        R --> G["git commit"]:::sto
    end
    subgraph DEPLOY["Deploy (each switch)"]
        direction TB
        P["scp + nv config patch"]:::eth --> D["nv config diff<br/>(the gate)"]:::ctl
        D --> A["nv config apply<br/>--confirm 300s"]:::eth
        A --> C["drift check"]:::gpu
    end
    BUILD --> DEPLOY
    classDef gpu fill:#DCEBFA,stroke:#1F5FAD,color:#0B2545
    classDef eth fill:#DDF2DC,stroke:#2E7D32,color:#123B14
    classDef ctl fill:#FDE8CF,stroke:#D9730D,color:#4A2604
    classDef oob fill:#ECECEC,stroke:#6B6B6B,color:#2A2A2A
    classDef sto fill:#D5F0EE,stroke:#00796B,color:#07332E