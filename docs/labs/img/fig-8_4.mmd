flowchart LR
    subgraph C1[" "]
        direction TB
        A["Symptom:<br/>slow or failing jobs"]:::bad --> B["sminfo<br/>one MASTER?"]:::ctl
        B --> C["ibqueryerrors<br/>who has errors?"]:::ib
        C --> D["iblinkinfo --switches-only -l<br/>Down / wrong width?"]:::ib
    end
    subgraph C2[" "]
        direction TB
        E["perfquery LID port<br/>which counters, rising?"]:::ib --> F["ibroute / ibtracert<br/>rerouted?"]:::ib
        F --> G["Fix: reseat or replace cable,<br/>clear counters, re-check"]:::eth
    end
    C1 --> C2
    style C1 fill:#FFFFFF,stroke:#FFFFFF
    style C2 fill:#FFFFFF,stroke:#FFFFFF
    classDef ib fill:#EADFF5,stroke:#6A3FA0,color:#2B1745
    classDef ctl fill:#FDE8CF,stroke:#D9730D,color:#4A2604
    classDef bad fill:#FADBD8,stroke:#C62828,color:#5B0F0F
    classDef eth fill:#DDF2DC,stroke:#2E7D32,color:#123B14