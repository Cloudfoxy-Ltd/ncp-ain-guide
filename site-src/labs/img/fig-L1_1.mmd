flowchart TB
    SET["nv set / nv unset"]:::oob --> PEND["Pending revision"]:::ctl
    PEND -->|"nv config diff"| DIFF["Review changes"]:::oob
    PEND -->|"nv config apply"| APPL["Applied<br/>(running switch)"]:::eth
    PEND -->|"nv config apply --confirm 2m"| TRIAL["Applied on trial"]:::bad
    TRIAL -->|"--confirm-yes"| APPL
    TRIAL -->|"timer expires"| ROLL["Automatic rollback"]:::bad
    APPL -->|"auto-save (default)<br/>or nv config save"| START["Startup<br/>/etc/nvue.d/startup.yaml"]:::gpu
    HIST["nv config history /<br/>nv config revision"]:::oob -->|"nv config apply &lt;rev&gt;"| APPL
